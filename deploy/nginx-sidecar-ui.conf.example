# Example nginx config for v2ray-egress-sidecar UI.
#
# Recommended:
#   1. Keep the admin API bound to 127.0.0.1.
#   2. Protect the public UI/API path with Basic Auth.
#   3. Use HTTPS on the public server block.
#   4. Configure SIDECAR_HTPASSWD_FILE, SIDECAR_COOKIE_SECURE=1 and
#      SIDECAR_COOKIE_PATH=/sidecar-stats/ for the API (see docs/authentication.md).
#   5. After adding the public locations below, back up nginx.conf and run:
#      sudo env PYTHONPATH=/usr/local/lib/v2ray-egress-sidecar \
#        python3 /usr/local/lib/v2ray-egress-sidecar/sidecar_nginx_auth.py /etc/nginx/nginx.conf
#      sudo nginx -t && sudo systemctl reload nginx
#      This adds a backend auth_request gate for pages AND stats.json, exact
#      login.html/auth.js exceptions, and propagates session cookies. Basic Auth
#      alone is NOT the complete session gate. Keep the internal check internal.
#
# Create Basic Auth credentials:
#   sudo htpasswd -cB /etc/nginx/.htpasswd-v2ray-egress-sidecar sidecar
# On systems whose crypt() does not support bcrypt, use htpasswd -c -5 instead.
# See docs/authentication.md; keep passwords and password files out of Git.
#
# Local-only dashboard:
server {
    listen 127.0.0.1:18081;
    server_name _;
    include /etc/nginx/mime.types;

    root /var/www/v2ray-egress-sidecar-dashboard;
    index index.html;

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:18082/api/;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# Public path example: paste this inside your existing HTTPS server block.
# Include /etc/nginx/mime.types in that server (or its enclosing http block).
#
