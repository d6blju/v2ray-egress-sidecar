[Unit]
Description=V2Ray egress sidecar for traffic stats and outbound selection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/v2ray-egress-sidecar --config /etc/v2ray-egress-sidecar/config.toml
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
